# IBM watsonx.ai credentials
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model ID — verify this against your IBM environment before filling in
# Examples: ibm/granite-13b-instruct-v2  |  ibm/granite-3-8b-instruct
WATSONX_MODEL_ID=

# AI backend selection: granite | langflow | orchestrate
AI_BACKEND=granite

# Optional: IBM Langflow flow endpoint (only used when AI_BACKEND=langflow)
LANGFLOW_FLOW_URL=

# RAG backend selection: simple | chroma
RAG_BACKEND=simple
